\\ w165_rest (02.10.2026): Nummern [16]; Fehler je Zahl nach fehler.txt, die anderen laufen weiter
default(parisizemax, 1400000000);
default(nbthreads, 1);
iferr(my(t0 = getwalltime()); my(c = primecert()); write("/out/cert_16.txt", c); write("/out/zeit.txt", 16, " ", 1687, " ", getwalltime() - t0), E, write("/out/fehler.txt", 16, " ", E));
quit
